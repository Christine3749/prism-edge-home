# Prism-Edge homepage configuration.
# Vite only exposes variables prefixed with VITE_ to browser code.

# Public canonical site URL after the production domain is attached.
VITE_SITE_URL="https://prismedge.tech"

# Optional: API console URL. When empty, the nav button falls back to the product section.
VITE_API_CONSOLE_URL=""

# Optional: Electron installer/download URL. When empty, the CTA falls back to early access.
VITE_DESKTOP_DOWNLOAD_URL=""
